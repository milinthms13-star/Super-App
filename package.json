{
  "name": "nilahub",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@capacitor/core": "^6.1.0",
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mediapipe/tasks-vision": "^0.10.8",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.19",
    "@mui/x-date-pickers": "^6.18.4",
    "@tensorflow/tfjs": "^4.11.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.6.0",
    "chart.js": "^4.5.1",
    "chroma-js": "^2.4.2",
    "cropperjs": "^1.6.1",
    "docx": "^9.5.1",
    "fabric": "^5.3.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.14.1",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "opentype.js": "^1.3.4",
    "papaparse": "^5.5.3",
    "pica": "^9.0.1",
    "quill": "^2.0.3",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "14.1.3",
    "react-icons": "^5.6.0",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.26.2",
    "react-scripts": "5.0.1",
    "socket.io-client": "^4.7.4",
    "three": "^0.158.0",
    "uuid": "^9.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "cross-env CI=false GENERATE_SOURCEMAP=false react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false",
    "test:astrology": "react-scripts test --testPathPattern=astrology",
    "test:hooks": "react-scripts test --testPathPattern=hooks",
    "test:views": "react-scripts test --testPathPattern=views",
    "eject": "react-scripts eject",
    "electron:dev": "cross-env ELECTRON_DEV=true BROWSER=none concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "capacitor:copy": "npm run build && npx cap copy",
    "capacitor:sync": "npx cap sync",
    "capacitor:add:android": "npx cap add android",
    "capacitor:add:ios": "npx cap add ios",
    "capacitor:open:android": "npx cap open android",
    "capacitor:open:ios": "npx cap open ios"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "cypress": "^15.15.0",
    "electron": "^26.4.0",
    "electron-builder": "^24.6.2",
    "jest-junit": "^17.0.0",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.nilahub.app",
    "productName": "NilaHub",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "build/**/*",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
