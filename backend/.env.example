# Core application
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000
AUTH_STORAGE=db
ADMIN_EMAIL=admin@example.com

# Database and cache
MONGODB_URI=mongodb://localhost:27017/malabarbazaar
REDIS_URL=redis://localhost:6379

# Astrology provider settings
ASTROLOGY_LIVE_MODE=false
ASTROLOGY_PROVIDER_BASE_URL=https://api.astrologyprovider.example
ASTROLOGY_PROVIDER_API_KEY=your-astrology-provider-api-key
ASTROLOGY_PROVIDER_CACHE_TTL_MS=300000

DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2

# Authentication and security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Uploads and asset delivery
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
CDN_URL=https://cdn.example.com
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Email providers
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-email-password-or-api-key
EMAIL_FROM=noreply@example.com

# Gmail OAuth
GMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# AWS integrations
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net

# Messaging
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Payments
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# BillPay provider switch
# Supported values: razorpay, setu
BILLPAY_PROVIDER=razorpay

# Setu Bharat Connect (BBPS) - required when BILLPAY_PROVIDER=setu
SETU_BILLPAY_BASE_URL=https://dg.setu.co
SETU_BILLPAY_API_VERSION=v1
SETU_BILLPAY_API_KEY=your_setu_billpay_api_key
SETU_BILLPAY_BEARER_TOKEN=
SETU_BILLPAY_CLIENT_ID=
SETU_BILLPAY_CLIENT_SECRET=
SETU_BILLPAY_AGENT_ID=your_setu_agent_id
SETU_BILLPAY_AGENT_CHANNEL=INT
SETU_BILLPAY_AGENT_APP=MGRAND HUB BillPay
SETU_BILLPAY_AGENT_MOBILE=
SETU_BILLPAY_AGENT_IFSC=
SETU_BILLPAY_REMITTER_NAME=MGRAND HUB USER
SETU_BILLPAY_CONSUMER_PARAM_NAME=Consumer Number
SETU_BILLPAY_TIMEOUT_MS=20000
SETU_BILLPAY_MAX_POLL_ATTEMPTS=5
SETU_BILLPAY_POLL_INTERVAL_MS=1200
SETU_BILLPAY_STRICT_MODE=false

# AI services
FREE_MODE=true
VIDEO_STUDIO_ALLOW_AI_IN_FREE=true
# Keep Gemini keys unset for free mode. Add only if you explicitly want paid Google AI.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Monitoring and observability
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Feature-specific local files
LOCALMARKET_DATA_FILE=./data/localmarket.json
