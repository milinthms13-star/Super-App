# ===========================================
# NODE ENVIRONMENT
# ===========================================
NODE_ENV=development
PORT=5000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/nilahub
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DATABASE=nilahub

# ===========================================
# REDIS CACHE
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=300
CACHE_MAX_TTL=3600

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-jwt-secret-must-be-at-least-32-characters-long
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-jwt-refresh-secret-must-be-at-least-32-characters
JWT_REFRESH_EXPIRE=30d

# ===========================================
# EMAIL CONFIGURATION (NODEMAILER)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@malabarbazaar.com
EMAIL_FROM_NAME=MalabarBazaar

# ===========================================
# RAZORPAY PAYMENT GATEWAY
# ===========================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# AWS S3 CONFIGURATION (OPTIONAL)
# ===========================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=malabarbazaar-uploads
USE_S3=false

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:5000

# ===========================================
# API CONFIGURATION
# ===========================================
API_RATE_LIMIT=100
API_RATE_WINDOW=900000
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ===========================================
# CORS CONFIGURATION
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# SECURITY
# ===========================================
# API Keys (comma-separated)
API_KEYS=

# Session secret
SESSION_SECRET=your-session-secret-key

# ===========================================
# BUSINESS BUILDER SPECIFIC
# ===========================================
# Invoice generation
INVOICE_PREFIX=INV
INVOICE_START_NUMBER=1000

# Mini app configuration
MINIAPP_BASE_URL=https://malabarbazaar.com/app

# QR code storage path
QRCODE_PATH=./uploads/qrcodes

# Export file retention (days)
EXPORT_RETENTION_DAYS=7

# File upload limits
MAX_LOGO_SIZE=2097152
MAX_BANNER_SIZE=5242880
MAX_PRODUCT_IMAGE_SIZE=3145728
MAX_INVOICE_ATTACHMENT_SIZE=10485760

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# Google Cloud (for AI services - optional)
GOOGLE_APPLICATION_CREDENTIALS=./config/google-credentials.json

# OpenAI API (for AI features - optional)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# Twilio (for SMS notifications - optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Sentry (error tracking - optional)
SENTRY_DSN=

# Google Analytics (optional)
GA_TRACKING_ID=

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_AI_FEATURES=true
ENABLE_PAYMENT_GATEWAY=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_FILE_UPLOADS=true
ENABLE_QR_CODES=true
ENABLE_WEBHOOKS=true
ENABLE_AUDIT_LOGS=true
ENABLE_DATA_EXPORT=true
ENABLE_CACHING=true

# ===========================================
# DEVELOPMENT/DEBUG
# ===========================================
DEBUG=false
CACHE_DEBUG=false
SQL_DEBUG=false
VERBOSE_LOGGING=false
